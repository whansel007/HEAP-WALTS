{
  "manifest_version": 3,
  "name": "Manga Tracker",
  "version": "3.2",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "images/icon-128.png"
    }
  },
  "icons": {
    "128": "images/icon-128.png"
  },
  "description": "Can bookmark manga and anime regularly or from MAL, with tags & query feature + auto-update button",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}